# 資料與權重不進版控
data/
*.mp4
*.pt
*.onnx
*.engine

# 結果輸出:文字報告(.md/.csv)可進版控,但 EPFL 衍生影像一律排除
# (EPFL 為 CC BY-NC + 畫面含人臉隱私,不得進公開 repo)
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/*.png
results/frames/
# zone 標註預覽圖 / HTML 含 EPFL 衍生畫面(人臉隱私),不入庫
*.preview.png
results/**/*.html

# 交付給標註幫手的整包(含內嵌 EPFL 衍生畫面,CC-BY-NC,不入庫)
標註交付包_*/

# 訓練權重(大檔;EPFL 丟棄驗證模型),不入庫
*.pth
model_result/

# ── 2026-09-04:放行**我們自己訓練**的權重,讓遠端那台可以直接訓練/推論 ──
# 用 Git LFS 存(見 .gitattributes)—— 兩個 checkpoint 都超過 GitHub 的 100 MB
# 硬限制,不走 LFS 的話 push 會直接被拒絕。
!model_result/
!model_result/nano/
!model_result/nano/*.pth
!model_result/medium/
!model_result/medium/*.pth
