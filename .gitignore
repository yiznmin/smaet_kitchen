results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/*.png
results/frames/
# zone 標註預覽圖 / HTML 含 EPFL 衍生畫面(人臉隱私),不入庫
*.preview.png
results/**/*.html

# 交付給標註幫手的整包(含內嵌 EPFL 衍生畫面,CC-BY-NC,不入庫)
標註交付包_*/

# 訓練權重(大檔;EPFL 丟棄驗證模型),不入庫
*.pth
model_result/
